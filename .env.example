# Advance Dermatology & Laser Medical Center — Server Configuration
# Copy this file to .env and populate credentials on the server (never commit .env).

# 1. AI Assistant Provider (configure one to enable live NITA AI responses)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 2. Clinic Portal Authentication (required to unlock #admin endpoints)
ADMIN_PASSWORD=

# 3. External Scheduling / Calendar Adapter (optional; when unset, patients submit appointment requests)
CALENDAR_API_URL=
CALENDAR_API_KEY=
CALENDAR_WEBHOOK_URL=

# 4. Server Port
PORT=8080
